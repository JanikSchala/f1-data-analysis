{
  "folders": [
    {
      "name": "F1 Portfolio",
      "path": "."
    }
  ],
  "settings": {
    "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python",
    "python.terminal.activateEnvironment": true,
    "editor.rulers": [88],
    "files.exclude": {
      "**/__pycache__": true,
      "**/.pytest_cache": true
    },
    "explorer.sortOrder": "default"
  },
  "extensions": {
    "recommendations": [
      "ms-python.python",
      "ms-python.vscode-pylance",
      "ms-toolsai.jupyter"
    ]
  }
}
